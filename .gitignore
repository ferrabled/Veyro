# Unity generated (per-machine, never commit)
game/[Ll]ibrary/
game/[Tt]emp/
game/[Oo]bj/
game/[Bb]uild/
game/[Bb]uilds/
game/[Ll]ogs/
game/[Uu]ser[Ss]ettings/
game/[Mm]emoryCaptures/
game/[Rr]ecordings/
game/.utmp/

# Unity crash/profiler artifacts
game/*.pidb.meta
game/sysinfo.txt
game/*.stackdump

# IDE
.vs/
.idea/
*.csproj
*.sln
*.user

# Build outputs at repo root
builds/
*.apk
*.aab
*.unitypackage

# OS
Thumbs.db
.DS_Store

# Secrets — never commit store keys or SDK credentials
*.keystore
*.jks
secrets/

# BlazePose/BlazeFace weights (T-010/T-010b). Apache-2.0 ONNX from Hugging Face
# unity/inference-engine-blaze-pose and -blaze-face. Not committed until Git LFS exists
# (D2 / T-006); enable with docs/cv-spike.sh on.
game/CvModels/
# The whole Resources tree under Assets/CV is transient build-time staging (models plus the
# committed files from Assets/CV/Data). Unity ships anything under a Resources/ folder in EVERY
# build (T-010b found the release APK silently carrying the anchor table), so nothing may live
# here permanently — CvSpikeBuild stages it per spike build and deletes it in a finally.
game/Assets/CV/Resources/
game/Assets/CV/Resources.meta

# Wrangler local state (account ids, caches) 
site/.wrangler/
